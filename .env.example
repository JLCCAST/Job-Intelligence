# Copia este archivo como .env y completa tus valores. NUNCA subas el .env.

# API key de Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Opcional: modelos de Gemini por agente, en orden de preferencia y
# separados por coma. La cuota gratuita es POR MODELO: si el primero
# agota su cuota del día, se usa el siguiente.
# Si no los pones, se usan los valores por defecto de app/gemini.py.
# GEMINI_MODELO_LUPA=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# GEMINI_MODELO_PLUMA=gemini-3.6-flash,gemini-3-flash-preview
# GEMINI_MODELO_BRUJULA=gemini-3.8-flash,gemini-3.6-flash
# GEMINI_MODELO=          # para todos los agentes (los de arriba mandan)

# Cadena de conexión de Supabase (Session pooler)
# postgresql://USUARIO:CONTRASEÑA@HOST:5432/postgres
SUPABASE_DB_URL=
